{
  "name": "fieldline",
  "version": "0.1.0",
  "description": "Intelligent Data Capture & Schedule-Linking Layer for Infrastructure Project Management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"tsx watch backend/src/index.ts\" \"vite --config frontend/vite.config.ts frontend\"",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts frontend",
    "test": "vitest run",
    "test:evaluation": "vitest run backend/tests/critical_workflow_e2e.test.ts",
    "test:watch": "vitest",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:frontend": "vite build frontend --config frontend/vite.config.ts",
    "setup": "tsx scripts/setup.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@napi-rs/canvas": "^1.0.8",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
