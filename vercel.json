{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist/frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fieldline-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
