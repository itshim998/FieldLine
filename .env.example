# FieldLine Environment Configuration
# Local-only SIH 2026 Presentation Application

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Local SQLite)
DATABASE_PATH=./database/fieldline.db

# Storage / Uploads
UPLOAD_DIR=./uploads

# Client / Frontend
VITE_PORT=3000

# AI Provider Configuration (Pass 18 & Pass 26)
# Options: mock | gemini | groq (default: mock for offline tests and golden demo)
AI_PROVIDER=mock

# Gemini AI Provider Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_TOKEN_LIMIT_PER_KEY=55000

# Gemini Multimodal Live Sequential Failover & Session Handover Credentials (20 Keys Supported)
# FieldLine uses sticky round-robin across 20 distinct Google AI Studio accounts.
# When a session approaches 55,000 tokens (approaching the 65K TPM ceiling) or encounters 429,
# the backend gateway seamlessly hands over the live session to the next healthy key.
GEMINI_API_KEY_01=
GEMINI_API_KEY_02=
GEMINI_API_KEY_03=
GEMINI_API_KEY_04=
GEMINI_API_KEY_05=
GEMINI_API_KEY_06=
GEMINI_API_KEY_07=
GEMINI_API_KEY_08=
GEMINI_API_KEY_09=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=
GEMINI_API_KEY_12=
GEMINI_API_KEY_13=
GEMINI_API_KEY_14=
GEMINI_API_KEY_15=
GEMINI_API_KEY_16=
GEMINI_API_KEY_17=
GEMINI_API_KEY_18=
GEMINI_API_KEY_19=
GEMINI_API_KEY_20=

# Groq AI Provider Configuration (Pass 26)
# Target Model: openai/gpt-oss-20b (supported on Groq endpoint)
GROQ_MODEL=openai/gpt-oss-20b

# Groq Sequential Failover Credentials (20 Keys Supported)
# FieldLine stays on the current Groq credential while requests succeed.
# When a credential encounters a qualifying failure (429, 401/403, 5xx, timeout),
# the router advances immediately to the next configured credential.
GROQ_API_KEY_01=
GROQ_API_KEY_02=
GROQ_API_KEY_03=
GROQ_API_KEY_04=
GROQ_API_KEY_05=
GROQ_API_KEY_06=
GROQ_API_KEY_07=
GROQ_API_KEY_08=
GROQ_API_KEY_09=
GROQ_API_KEY_10=
GROQ_API_KEY_11=
GROQ_API_KEY_12=
GROQ_API_KEY_13=
GROQ_API_KEY_14=
GROQ_API_KEY_15=
GROQ_API_KEY_16=
GROQ_API_KEY_17=
GROQ_API_KEY_18=
GROQ_API_KEY_19=
GROQ_API_KEY_20=

# Phase 3 — Free HTTP Email Delivery Configuration (Resend over HTTPS)
# By default, EMAIL_ENABLED is false to ensure safe, 100% offline tests and demos.
EMAIL_ENABLED=false

# Resend API Key (starts with re_...)
# Required only when EMAIL_ENABLED=true. Obtain free key at https://resend.com
RESEND_API_KEY=

# Resend Sender Address
# IMPORTANT SENDER RESTRICTION NOTE:
# - The default 'FieldLine Alerts <onboarding@resend.dev>' is a sandbox testing sender provided by Resend.
# - In Resend's free tier, emails sent from 'onboarding@resend.dev' can ONLY be delivered to the single
#   email address associated with your Resend account.
# - For real administrator delivery to arbitrary/multiple recipients, you MUST verify a custom sending domain
#   in your Resend dashboard (e.g. 'FieldLine Alerts <alerts@yourprojectdomain.com>').
EMAIL_FROM=FieldLine Alerts <onboarding@resend.dev>

# Anomaly Alert Administrator Recipients
# Comma-, semicolon-, or whitespace-delimited list of administrator email addresses.
# Required only when EMAIL_ENABLED=true.
ANOMALY_ALERT_RECIPIENTS=

