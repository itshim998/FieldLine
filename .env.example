# FieldLine Environment Configuration
# Local-only SIH 2026 Presentation Application

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Local SQLite)
DATABASE_PATH=./database/fieldline.db

# Storage / Uploads
UPLOAD_DIR=./uploads

# Client / Frontend
VITE_PORT=3000

# AI Provider Configuration (PASS 18)
# Options: mock | gemini (default: mock for offline tests and development)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

